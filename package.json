{
  "name": "aetheris-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation tooling for Aetheris (not published)",
  "scripts": {
    "a11y:static": "html-validate \"site/**/*.html\" --formatter stylish",
    "a11y:rendered": "node scripts/check_a11y_rendered.js site/",
    "a11y": "npm run a11y:static && npm run a11y:rendered",
    "docs:html": "node scripts/fix_built_html.js site/"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "html-validate": "^8.0.0"
  }
}
