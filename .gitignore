# ---------------------------------------------------------------------------
# Aetheris .gitignore — patterns derived from plan.md tech stack (Python)
# Project Setup Verification step of /speckit.implement
# ---------------------------------------------------------------------------

# Python — build & bytecode
__pycache__/
*.py[cod]
*$py.class
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
.env.bak/
venv.bak/

# Python — testing / typing / formatting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/
htmlcov/
.tox/
.nox/
.cache

# Secrets — never commit (constitution: Secrets)
.env
.env.*
!.env.example
# The TOML config path can hold credentials too, so it is ignored by default
# while the documented example file is tracked.
aetheris.toml
aetheris.toml.local
*.pem
*.key
secrets.yml

# Project data & artifacts (local self-hosted stores)
*.duckdb
*.wal
aetheris-raw.db
mlflow.db
mlruns/
mlartifacts/

# Model weights & caches (downloaded, never committed). Anchored to the root:
# an unanchored `models/` also hid tests/fixtures/models/, so the stub model the
# test suite imports never reached CI.
/models/
.cache/huggingface/
.huggingface/
*.safetensors
!tests/fixtures/models/**/*.safetensors

# Recorded provider cassettes may contain real API responses — verify before
# committing cassettes produced against live free-tier accounts.
tests/fixtures/cassettes/*.yaml

# OS / editor
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.tmp
*.swp
*~
.idea/
.vscode/
*.iml

# Logs
*.log
logs/
npm-debug.log*

# Node — docs tooling (feature 001-docs-site-cicd)
node_modules/
.playwright-artifacts/

# Documentation build output & generated reference (VR-3)
site/
docs/SUMMARY.md
docs/reference/
docs/validation.md
