# Aetheris credential template.
#
# Copy to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored (see .gitignore) and is never committed. Real environment
# variables take precedence over this file, so an exported key always wins.

# --- Provider keys (free tiers) ---------------------------------------------
# Leave a provider blank to leave it unconfigured; the pipeline continues with
# the providers it does have.
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=
TIINGO_API_KEY=

# --- Storage (optional; defaults shown) -------------------------------------
# AETHERIS_DB=./aetheris.duckdb
# AETHERIS_RAW_DB=./aetheris-raw.db

# --- Telemetry (optional) ---------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# AETHERIS_TRACE_STDOUT=1          # also print spans to stdout
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# --- Alternative credential file location -----------------------------------
# AETHERIS_ENV_FILE=./.env.secrets
